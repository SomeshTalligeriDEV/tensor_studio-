# OpenAI-compatible provider. Server only; use a model enabled for your account.
# Choose a compatible endpoint and a model enabled for your account.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Server only. Copy to .env.local for development.
CHUTES_API_KEY=
# Comma-separated model IDs from https://llm.chutes.ai/v1/models (first is default).
CHUTES_MODELS=
# Optional OpenAI-compatible fallback; chosen explicitly in AI model settings.
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=
