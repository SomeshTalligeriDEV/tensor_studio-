{
  "name": "TensorScan localnet development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [
    8788
  ],
  "portsAttributes": {
    "8788": {
      "label": "Read-only Subtensor RPC",
      "visibility": "public",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm ci --ignore-scripts --no-audit --no-fund && npm test",
  "remoteUser": "node",
  "postStartCommand": "bash ensure-localnet.sh"
}
