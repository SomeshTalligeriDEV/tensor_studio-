# TensorStudio environment reference. No live credentials belong here.
# Use apps/web/.env.local and apps/runner/.env.local.
# Run python3 scripts/setup-local.py to create and pair local environment files.

# Web assistant: your configured OpenAI-compatible inference service.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Runner miner inference: configure in apps/runner/.env.local.
BITCODE_MODEL_API_KEY=
BITCODE_MODEL_BASE_URL=
BITCODE_MODEL_ID=

# Chain: use your development chain for localnet workflows.
# Public testnet browsing works independently from development-chain writes.
CHAIN_WS=
RUNNER_PORT=8787
RUNNER_TOKEN=
